# Copy this file to infrastructure/.env (gitignored) before running
# `docker compose up`. Values here are safe development-only placeholders —
# never put real credentials in this file.
#
# These names intentionally match backend/.env.example so the same values
# can be reused for both the containers and the backend app config.

POSTGRES_USER=amnix
POSTGRES_PASSWORD=changeme
POSTGRES_DB=amnix

REDIS_PASSWORD=changeme

# NOTE (this machine only): docker-compose.yml maps postgres to host port
# 5433 and redis to host port 6380, because another project already binds
# host 5432/6379. If your backend/.env talks to these containers from the
# host, set POSTGRES_PORT=5433 and REDIS_PORT=6380 there. On a machine
# without that conflict, both docker-compose.yml and backend/.env can use
# the standard 5432/6379 ports.
