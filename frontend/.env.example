# AMNIX frontend — local development configuration.
# Copy to .env.local (git-ignored) and adjust if your backend runs
# somewhere other than the default below. Never commit real values here
# beyond documented, non-sensitive defaults.

# Base URL of the AMNIX backend API (see backend/app/main.py). The
# backend has no fixed port of its own -- it is whatever `uvicorn` was
# started with locally (see backend's README/docs for the exact
# command). Must NOT have a trailing slash.
VITE_API_BASE_URL=http://localhost:8000
