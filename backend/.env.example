# Application
APP_NAME=amnix
ENVIRONMENT=development
DEBUG=false

# PostgreSQL
POSTGRES_USER=amnix
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=amnix

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0

# Detection engine
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=300

# AI Copilot
# "mock" (the default) is deterministic, offline, and requires no
# credentials. Set to "anthropic" to use the real Anthropic provider —
# doing so requires ANTHROPIC_API_KEY below, or the app will fail to
# construct the provider with a clear configuration error.
AI_PROVIDER=mock

# Anthropic provider (only used when AI_PROVIDER=anthropic).
# Leave ANTHROPIC_API_KEY empty for local/dev/CI use with the default
# mock provider. Never put a real key in this file — it is committed to
# the repo; put real keys only in a local, git-ignored .env file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT_SECONDS=30

# Authentication (Step 11D). JWT_SECRET_KEY signs/verifies access
# tokens (see app.core.tokens) -- never commit a real value here; put
# one only in a local, git-ignored .env file. Token issuance/validation
# fails fast and loudly if this is empty, rather than signing with an
# empty or predictable key.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=amnix
JWT_AUDIENCE=amnix-api
REFRESH_TOKEN_EXPIRE_DAYS=7

# HTTP security boundary (Step 11L). Both are comma-separated lists and
# must NEVER be set to "*" -- the app refuses to start if either is.
#
# CORS_ALLOWED_ORIGINS: as of Step 12A, the AMNIX frontend
# (frontend/, Vite + React) exists and runs on Vite's default dev port
# -- see app.core.config.Settings.cors_allowed_origins's own docstring
# for why no origin is assumed by default in code. Uncomment for local
# frontend development; a real deployment must set its own real origin.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=
# TRUSTED_HOSTS: defaults to exactly the hosts local development and
# this project's test suite actually need (localhost, 127.0.0.1, and
# "testserver" -- Starlette TestClient's own default Host header). A
# real deployment MUST set this to its real domain(s); the default does
# not match any real production hostname, so it fails closed for
# anything other than local dev/test if left unset.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
